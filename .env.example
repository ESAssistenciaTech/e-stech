# Copie para .env.local e preencha. .env.local nunca é commitado.
# Dashboard do Supabase -> Connect

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A chave sb_secret_... ignora RLS por completo e NÃO entra aqui.
# Se algum dia for necessária, vai como variável de ambiente só no
# servidor (Vercel), nunca em arquivo do repositório e nunca com
# prefixo NEXT_PUBLIC_, que expõe o valor no bundle do navegador.

# Cloudinary — Settings > API Keys no painel.
# O upload é assinado no servidor, então o SECRET nunca chega ao navegador.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Usuário de teste — opcional. Sem estas duas, os testes autenticados pulam
# em vez de falhar, e o resto da suíte roda igual.
#
# Crie um usuário só para isso em Supabase -> Authentication -> Users, com
# senha gerada na hora. Ela vive aqui e em lugar nenhum mais: .env.local não
# é versionado, e senha de teste em texto no repositório é como o
# claude@gmail.com virou pendência de segurança.
#
# ATENÇÃO: esses testes ESCREVEM no banco de NEXT_PUBLIC_SUPABASE_URL. Criam
# registros com prefixo "zz-teste-" e apagam no fim, e varrem sobra antes de
# começar — mas se um deles quebrar no meio, a sobra fica visível nas telas
# até a próxima execução. Para isolar de vez, aponte um segundo projeto
# Supabase (o plano gratuito permite dois).
TESTE_EMAIL=
TESTE_SENHA=

# Onde os testes de tela batem. Só mude se o dev subir noutra porta.
# TESTE_URL=http://localhost:3000
